# Normalise line endings in the repository; the project stores LF everywhere.
* text=auto eol=lf

*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.py   text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.ico binary
