{
  "name": "colaborator-extension",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Multi-session OAST dashboard for Chrome (Burp Collaborator / interactsh).",
  "license": "MIT",
  "author": "RedDySter20",
  "homepage": "https://github.com/RedDySter20/ColaboratorExtension",
  "repository": {
    "type": "git",
    "url": "https://github.com/RedDySter20/ColaboratorExtension.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:coverage": "node --experimental-test-coverage scripts/test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "build:zip": "node scripts/build.mjs --zip",
    "icons": "python scripts/make-icons.py",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.1",
    "fake-indexeddb": "^6.2.2",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
